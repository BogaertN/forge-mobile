{"shard": "tv", "count": 10, "anchors": [{"id": "enc-cia-tv-0", "text": "Funafuti is the capital of Tuvalu.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.TUVALU"], "concept": "A.TUVALU", "provenance": {"source": "cia-world-factbook", "source_url": "https://www.cia.gov/the-world-factbook/countries/tv/", "revision": "factbook.json", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "terms": "https://www.usa.gov/government-works", "historical": false, "ingestion_note": "Sentence cut at ingestion from the CIA World Factbook. The factbook.json mirror is CC0. Recall does not segment text.", "contributor": "encyclopedia:cia-world-factbook"}, "contributor": "encyclopedia:cia-world-factbook", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "source_url": "https://www.cia.gov/the-world-factbook/countries/tv/", "revision": "factbook.json", "historical": false}, {"id": "enc-cia-tv-1", "text": "Voyagers from either Samoa or Tonga first populated Tuvalu in the first millennium A.D., and the islands provided a stepping-stone for various Polynesian communities that subsequently settled in Melanesia and Micronesia.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.TUVALU"], "concept": "A.TUVALU", "provenance": {"source": "cia-world-factbook", "source_url": "https://www.cia.gov/the-world-factbook/countries/tv/", "revision": "factbook.json", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "terms": "https://www.usa.gov/government-works", "historical": false, "ingestion_note": "Sentence cut at ingestion from the CIA World Factbook. The factbook.json mirror is CC0. Recall does not segment text.", "contributor": "encyclopedia:cia-world-factbook"}, "contributor": "encyclopedia:cia-world-factbook", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "source_url": "https://www.cia.gov/the-world-factbook/countries/tv/", "revision": "factbook.json", "historical": false}, {"id": "enc-cia-tv-2", "text": "Tuvalu eventually came under Samoan and Tongan spheres of influence, although proximity to Micronesia allowed some Micronesian communities to flourish in Tuvalu, in particular on Nui Atoll.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.TUVALU"], "concept": "A.TUVALU", "provenance": {"source": "cia-world-factbook", "source_url": "https://www.cia.gov/the-world-factbook/countries/tv/", "revision": "factbook.json", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "terms": "https://www.usa.gov/government-works", "historical": false, "ingestion_note": "Sentence cut at ingestion from the CIA World Factbook. The factbook.json mirror is CC0. Recall does not segment text.", "contributor": "encyclopedia:cia-world-factbook"}, "contributor": "encyclopedia:cia-world-factbook", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "source_url": "https://www.cia.gov/the-world-factbook/countries/tv/", "revision": "factbook.json", "historical": false}, {"id": "enc-cia-tv-3", "text": "In the late 1700s and early 1800s, a series of American, British, Dutch, and Russian ships visited the islands, which were named the Ellice Islands in 1819.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.TUVALU"], "concept": "A.TUVALU", "provenance": {"source": "cia-world-factbook", "source_url": "https://www.cia.gov/the-world-factbook/countries/tv/", "revision": "factbook.json", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "terms": "https://www.usa.gov/government-works", "historical": false, "ingestion_note": "Sentence cut at ingestion from the CIA World Factbook. The factbook.json mirror is CC0. Recall does not segment text.", "contributor": "encyclopedia:cia-world-factbook"}, "contributor": "encyclopedia:cia-world-factbook", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "source_url": "https://www.cia.gov/the-world-factbook/countries/tv/", "revision": "factbook.json", "historical": false}, {"id": "enc-cia-tv-4", "text": "The UK declared a protectorate over islands in 1892 and merged them with the Micronesian Gilbert Islands.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.TUVALU"], "concept": "A.TUVALU", "provenance": {"source": "cia-world-factbook", "source_url": "https://www.cia.gov/the-world-factbook/countries/tv/", "revision": "factbook.json", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "terms": "https://www.usa.gov/government-works", "historical": false, "ingestion_note": "Sentence cut at ingestion from the CIA World Factbook. The factbook.json mirror is CC0. Recall does not segment text.", "contributor": "encyclopedia:cia-world-factbook"}, "contributor": "encyclopedia:cia-world-factbook", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "source_url": "https://www.cia.gov/the-world-factbook/countries/tv/", "revision": "factbook.json", "historical": false}, {"id": "enc-cia-tv-5", "text": "The Gilbert and Ellice Islands Protectorate became a colony in 1916.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.TUVALU"], "concept": "A.TUVALU", "provenance": {"source": "cia-world-factbook", "source_url": "https://www.cia.gov/the-world-factbook/countries/tv/", "revision": "factbook.json", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "terms": "https://www.usa.gov/government-works", "historical": false, "ingestion_note": "Sentence cut at ingestion from the CIA World Factbook. The factbook.json mirror is CC0. Recall does not segment text.", "contributor": "encyclopedia:cia-world-factbook"}, "contributor": "encyclopedia:cia-world-factbook", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "source_url": "https://www.cia.gov/the-world-factbook/countries/tv/", "revision": "factbook.json", "historical": false}, {"id": "enc-cia-tv-6", "text": "During World War II, the US set up military bases on a few islands, and in 1943, after Japan captured many of the northern Gilbert Islands, the UK transferred administration of the colony southward to Funafuti.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.TUVALU"], "concept": "A.TUVALU", "provenance": {"source": "cia-world-factbook", "source_url": "https://www.cia.gov/the-world-factbook/countries/tv/", "revision": "factbook.json", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "terms": "https://www.usa.gov/government-works", "historical": false, "ingestion_note": "Sentence cut at ingestion from the CIA World Factbook. The factbook.json mirror is CC0. Recall does not segment text.", "contributor": "encyclopedia:cia-world-factbook"}, "contributor": "encyclopedia:cia-world-factbook", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "source_url": "https://www.cia.gov/the-world-factbook/countries/tv/", "revision": "factbook.json", "historical": false}, {"id": "enc-cia-tv-7", "text": "After the war, Tarawa in the Gilbert Islands was once again made the colony’s capital, and the center of power was firmly in the Gilbert Islands, including the colony’s only secondary school.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.TUVALU"], "concept": "A.TUVALU", "provenance": {"source": "cia-world-factbook", "source_url": "https://www.cia.gov/the-world-factbook/countries/tv/", "revision": "factbook.json", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "terms": "https://www.usa.gov/government-works", "historical": false, "ingestion_note": "Sentence cut at ingestion from the CIA World Factbook. The factbook.json mirror is CC0. Recall does not segment text.", "contributor": "encyclopedia:cia-world-factbook"}, "contributor": "encyclopedia:cia-world-factbook", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "source_url": "https://www.cia.gov/the-world-factbook/countries/tv/", "revision": "factbook.json", "historical": false}, {"id": "enc-cia-tv-8", "text": "Amid growing tensions with the Gilbertese, Tuvaluans voted to secede from the colony in 1974, were granted self-rule in 1975, and gained independence in 1978 as Tuvalu.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.TUVALU"], "concept": "A.TUVALU", "provenance": {"source": "cia-world-factbook", "source_url": "https://www.cia.gov/the-world-factbook/countries/tv/", "revision": "factbook.json", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "terms": "https://www.usa.gov/government-works", "historical": false, "ingestion_note": "Sentence cut at ingestion from the CIA World Factbook. The factbook.json mirror is CC0. Recall does not segment text.", "contributor": "encyclopedia:cia-world-factbook"}, "contributor": "encyclopedia:cia-world-factbook", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "source_url": "https://www.cia.gov/the-world-factbook/countries/tv/", "revision": "factbook.json", "historical": false}, {"id": "enc-cia-tv-9", "text": "In 1979, the US relinquished its claims to the Tuvaluan islands in a treaty of friendship.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.TUVALU"], "concept": "A.TUVALU", "provenance": {"source": "cia-world-factbook", "source_url": "https://www.cia.gov/the-world-factbook/countries/tv/", "revision": "factbook.json", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "terms": "https://www.usa.gov/government-works", "historical": false, "ingestion_note": "Sentence cut at ingestion from the CIA World Factbook. The factbook.json mirror is CC0. Recall does not segment text.", "contributor": "encyclopedia:cia-world-factbook"}, "contributor": "encyclopedia:cia-world-factbook", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "source_url": "https://www.cia.gov/the-world-factbook/countries/tv/", "revision": "factbook.json", "historical": false}]}