{"shard": "bx", "count": 6, "anchors": [{"id": "enc-cia-bx-0", "text": "Bandar Seri Begawan is the capital of Brunei.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.BRUNEI"], "concept": "A.BRUNEI", "provenance": {"source": "cia-world-factbook", "source_url": "https://www.cia.gov/the-world-factbook/countries/bx/", "revision": "factbook.json", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "terms": "https://www.usa.gov/government-works", "historical": false, "ingestion_note": "Sentence cut at ingestion from the CIA World Factbook. The factbook.json mirror is CC0. Recall does not segment text.", "contributor": "encyclopedia:cia-world-factbook"}, "contributor": "encyclopedia:cia-world-factbook", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "source_url": "https://www.cia.gov/the-world-factbook/countries/bx/", "revision": "factbook.json", "historical": false}, {"id": "enc-cia-bx-1", "text": "The Sultanate of Brunei's influence peaked between the 15th and 17th centuries, when its control extended over coastal areas of northwest Borneo and the southern Philippines.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.BRUNEI"], "concept": "A.BRUNEI", "provenance": {"source": "cia-world-factbook", "source_url": "https://www.cia.gov/the-world-fa