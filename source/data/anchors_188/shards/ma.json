{"shard": "ma", "count": 15, "anchors": [{"id": "enc-cia-ma-0", "text": "Antananarivo is the capital of Madagascar.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.MADAGASCAR"], "concept": "A.MADAGASCAR", "provenance": {"source": "cia-world-factbook", "source_url": "https://www.cia.gov/the-world-factbook/countries/ma/", "revision": "factbook.json", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "terms": "https://www.usa.gov/government-works", "historical": false, "ingestion_note": "Sentence cut at ingestion from the CIA World Factbook. The factbook.json mirror is CC0. Recall does not segment text.", "contributor": "encyclopedia:cia-world-factbook"}, "contributor": "encyclopedia:cia-world-factbook", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "source_url": "https://www.cia.gov/the-world-factbook/countries/ma/", "revision": "factbook.json", "historical": false}, {"id": "enc-cia-ma-1", "text": "Madagascar was one of the last major habitable landmasses on earth to be settled by humans.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.MADAGASCAR"], "concept": "A.MADAGASCAR", "provenance": {"source": "cia-world-factbook", "source_url": "https://www.cia.gov/the-world-factbook/countries/ma/", "revision": "factbook.json", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "terms": "https://www.usa.gov/government-works", "historical": false, "ingestion_note": "Sentence cut at ingestion from the CIA World Factbook. The factbook.json mirror is CC0. Recall does not segment text.", "contributor": "encyclopedia:cia-world-factbook"}, "contributor": "encyclopedia:cia-world-factbook", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "source_url": "https://www.cia.gov/the-world-factbook/countries/ma/", "revision": "factbook.json", "historical": false}, {"id": "enc-cia-ma-10", "text": "After a lengthy mediation process, Madagascar held UN-supported presidential and parliamentary elections in 2013.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.MADAGASCAR"], "concept": "A.MADAGASCAR", "provenance": {"source": "cia-world-factbook", "source_url": "https://www.cia.gov/the-world-factbook/countries/ma/", "revision": "factbook.json", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "terms": "https://www.usa.gov/government-works", "historical": false, "ingestion_note": "Sentence cut at ingestion from the CIA World Factbook. The factbook.json mirror is CC0. Recall does not segment text.", "contributor": "encyclopedia:cia-world-factbook"}, "contributor": "encyclopedia:cia-world-factbook", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "source_url": "https://www.cia.gov/the-world-factbook/countries/ma/", "revision": "factbook.json", "historical": false}, {"id": "enc-cia-ma-11", "text": "Former de facto finance minister Hery RAJAONARIMAMPIANINA won in a runoff and was inaugurated in 2014.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.MADAGASCAR"], "concept": "A.MADAGASCAR", "provenance": {"source": "cia-world-factbook", "source_url": "https://www.cia.gov/the-world-factbook/countries/ma/", "revision": "factbook.json", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "terms": "https://www.usa.gov/government-works", "historical": false, "ingestion_note": "Sentence cut at ingestion from the CIA World Factbook. The factbook.json mirror is CC0. Recall does not segment text.", "contributor": "encyclopedia:cia-world-factbook"}, "contributor": "encyclopedia:cia-world-factbook", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "source_url": "https://www.cia.gov/the-world-factbook/countries/ma/", "revision": "factbook.json", "historical": false}, {"id": "enc-cia-ma-12", "text": "In 2019, RAJOELINA was declared the winner against RAVALOMANANA.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.MADAGASCAR"], "concept": "A.MADAGASCAR", "provenance": {"source": "cia-world-factbook", "source_url": "https://www.cia.gov/the-world-factbook/countries/ma/", "revision": "factbook.json", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "terms": "https://www.usa.gov/government-works", "historical": false, "ingestion_note": "Sentence cut at ingestion from the CIA World Factbook. The factbook.json mirror is CC0. Recall does not segment text.", "contributor": "encyclopedia:cia-world-factbook"}, "contributor": "encyclopedia:cia-world-factbook", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "source_url": "https://www.cia.gov/the-world-factbook/countries/ma/", "revision": "factbook.json", "historical": false}, {"id": "enc-cia-ma-13", "text": "In 2023, RAJOELINA won another term in an election that most of the opposition boycotted, including RAJAONARIMAMPIANINA and RAVALOMANANA, who claimed it was rigged in favor of RAJOELINA.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.MADAGASCAR"], "concept": "A.MADAGASCAR", "provenance": {"source": "cia-world-factbook", "source_url": "https://www.cia.gov/the-world-factbook/countries/ma/", "revision": "factbook.json", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "terms": "https://www.usa.gov/government-works", "historical": false, "ingestion_note": "Sentence cut at ingestion from the CIA World Factbook. The factbook.json mirror is CC0. Recall does not segment text.", "contributor": "encyclopedia:cia-world-factbook"}, "contributor": "encyclopedia:cia-world-factbook", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "source_url": "https://www.cia.gov/the-world-factbook/countries/ma/", "revision": "factbook.json", "historical": false}, {"id": "enc-cia-ma-14", "text": "International observers, however, saw no evidence of systemic fraud, leading the international community to accept the election results.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.MADAGASCAR"], "concept": "A.MADAGASCAR", "provenance": {"source": "cia-world-factbook", "source_url": "https://www.cia.gov/the-world-factbook/countries/ma/", "revision": "factbook.json", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "terms": "https://www.usa.gov/government-works", "historical": false, "ingestion_note": "Sentence cut at ingestion from the CIA World Factbook. The factbook.json mirror is CC0. Recall does not segment text.", "contributor": "encyclopedia:cia-world-factbook"}, "contributor": "encyclopedia:cia-world-factbook", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "source_url": "https://www.cia.gov/the-world-factbook/countries/ma/", "revision": "factbook.json", "historical": false}, {"id": "enc-cia-ma-2", "text": "Madagascar was a pirate stronghold during the late 17th and early 18th centuries and served as a slave trading center into the 19th century.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.MADAGASCAR"], "concept": "A.MADAGASCAR", "provenance": {"source": "cia-world-factbook", "source_url": "https://www.cia.gov/the-world-factbook/countries/ma/", "revision": "factbook.json", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "terms": "https://www.usa.gov/government-works", "historical": false, "ingestion_note": "Sentence cut at ingestion from the CIA World Factbook. The factbook.json mirror is CC0. Recall does not segment text.", "contributor": "encyclopedia:cia-world-factbook"}, "contributor": "encyclopedia:cia-world-factbook", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "source_url": "https://www.cia.gov/the-world-factbook/countries/ma/", "revision": "factbook.json", "historical": false}, {"id": "enc-cia-ma-3", "text": "From the 16th to the late 19th century, a native Merina Kingdom dominated much of Madagascar.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.MADAGASCAR"], "concept": "A.MADAGASCAR", "provenance": {"source": "cia-world-factbook", "source_url": "https://www.cia.gov/the-world-factbook/countries/ma/", "revision": "factbook.json", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "terms": "https://www.usa.gov/government-works", "historical": false, "ingestion_note": "Sentence cut at ingestion from the CIA World Factbook. The factbook.json mirror is CC0. Recall does not segment text.", "contributor": "encyclopedia:cia-world-factbook"}, "contributor": "encyclopedia:cia-world-factbook", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "source_url": "https://www.cia.gov/the-world-factbook/countries/ma/", "revision": "factbook.json", "historical": false}, {"id": "enc-cia-ma-4", "text": "The French conquered the island in 1896 and made it a colony; independence was regained in 1960.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.MADAGASCAR"], "concept": "A.MADAGASCAR", "provenance": {"source": "cia-world-factbook", "source_url": "https://www.cia.gov/the-world-factbook/countries/ma/", "revision": "factbook.json", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "terms": "https://www.usa.gov/government-works", "historical": false, "ingestion_note": "Sentence cut at ingestion from the CIA World Factbook. The factbook.json mirror is CC0. Recall does not segment text.", "contributor": "encyclopedia:cia-world-factbook"}, "contributor": "encyclopedia:cia-world-factbook", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "source_url": "https://www.cia.gov/the-world-factbook/countries/ma/", "revision": "factbook.json", "historical": false}, {"id": "enc-cia-ma-5", "text": "Free presidential and National Assembly elections were held in 1992-93, ending 17 years of single-party rule.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.MADAGASCA