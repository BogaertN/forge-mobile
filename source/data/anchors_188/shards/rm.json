right-and-contributors/", "source_url": "https://www.cia.gov/the-world-factbook/countries/rm/", "revision": "factbook.json", "historical": false}, {"id": "enc-cia-rm-6", "text": "The US captured the islands in heavy fighting during World War II, and the islands came under US administration as part of the Trust Territory of the Pacific Islands (TTPI) in 1947.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "FORGE-RESONANCE-PACKET/v1", "Phi": 1, "eps": 0.0, "mu": 1.0, "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "placed_by": "athena", "standing": "anchor", "phi_basis": "ingestion placement; factual anchor, phase Φ1"}, "concepts": ["A.MARSHALLISLANDS"], "concept": "A.MARSHALLISLANDS", "provenance": {"source": "cia-world-factbook", "source_url": "https://www.cia.gov/the-world-factbook/countries/rm/", "revision": "factbook.json", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "terms": "https://www.usa.gov/government-works", "historical": false, "ingestion_note": "Sentence cut at ingestion from the CIA World Factbook. The factbook.json mirror is CC0. Recall does not segment text.", "contributor": "encyclopedia:cia-world-factbook"}, "contributor": "encyclopedia:cia-world-factbook", "license": "public-domain", "license_url": "https://www.cia.gov/the-world-factbook/about/copyright-and-contributors/", "source_url": "https://www.cia.gov/the-world-factbook/countries/rm/", "revision": "factbook.json", "historical": false}, {"id": "enc-cia-rm-7", "text": "Between 1946 and 1958, the US resettled populations from Bikini and Enewetak Atolls and conducted 67 nuclear tests; people from Ailinginae, Rongelap, and Utrik Atolls were also evacuated because of nuclear fallout, and Bikini and Rongelap remain largely uninhabited.", "tier": "anchor", "state": "anchor", "trust": "trusted", "sfe": {"Phi": 1, "eps": 0.0, "mu": 1.0}, "packet": {"schema": "F